# ===== قاعدة البيانات =====
# PostgreSQL (التطوير المحلي)
# على Windows يُنشئ scripts/setup-local.ps1 ملف .env تلقائياً.
DATABASE_URL=postgresql://bch_local_user:replace-with-strong-password@127.0.0.1:5000/bch_local?schema=public

# ===== التهيئة الأولى =====
INITIAL_SETUP_TOKEN=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
INITIAL_ADMIN_NAME=المسؤول العام
ALLOW_DEMO_SEED=false

# ===== التخزين الخارجي للنسخ الاحتياطية (اختياري) =====
# Google Drive: شارك المجلد مع client_email الموجود في حساب الخدمة.
# GOOGLE_DRIVE_FOLDER_ID=replace-with-drive-folder-id
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}'

# WebDAV / Nextcloud أو أي خادم يدعم PUT عبر HTTPS
# BACKUP_WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/user/BCH-backups/
# BACKUP_WEBDAV_USERNAME=backup-user
# BACKUP_WEBDAV_PASSWORD=replace-with-an-app-password

# ===== البيئة =====
# NODE_ENV=production  # اضبطه في الإنتاج

# ===== SMTP (إشعارات الشكايات العمومية) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM="منصة BCH <notifications@example.com>"
