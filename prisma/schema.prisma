generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Intervention {
  id                 String   @id @default(cuid())
  type               String   // DERATISATION, DESINSECTISATION, DESINFECTION
  gisLayer           String   @default("interventions") // طبقة الخريطة المرتبطة
  date               DateTime
  quartier           String
  adresse            String
  commune            String   @default("")
  latitude           Float
  longitude          Float
  statut             String   // PLANIFIEE, EN_COURS, TERMINEE, ANNULEE
  description        String   @default("")
  agentNom           String
  produitUtilise     String   @default("")
  quantite           String   @default("")
  superficie         String   @default("")
  nombrePrestations  Int      @default(1)
  observations       String   @default("")
  heureDebut         String?  // "08:00"
  heureFin           String?  // "10:00"
  coutMainOeuvre     Float?   // تكلفة اليد العاملة
  coutMateriaux      Float?   // تكلفة المواد
  coutTotal          Float?   // التكلفة الإجمالية
  reference          String   @unique
  campagneId         String?  // ربط اختياري بحملة (Campagne)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  materials          InterventionMaterial[]
  documents          InterventionDocument[]
  photos             InterventionPhoto[]
  complaints         Complaint[]
  workOrders         WorkOrder[]
  comments           InterventionComment[]
  campagne           Campagne? @relation(fields: [campagneId], references: [id], onDelete: SetNull)
}

model Campagne {
  id            String   @id @default(cuid())
  nom           String   // اسم الحملة
  type          String   // DERATISATION, DESINSECTISATION, DESINFECTION, MIXTE
  commune       String   @default("") // الجماعة الترابية (أو ALL للكل)
  description   String   @default("") // وصف الحملة
  objectif      String   @default("") // الهدف العام للحملة
  budgetPrevu   Float?   // الميزانية المخططة
  coutReel      Float?   // التكلفة الفعلية (محسوبة من التدخلات المرتبطة)
  dateDebut     DateTime // تاريخ بداية الحملة
  dateFin       DateTime? // تاريخ نهاية الحملة (nullable للحملات الجارية)
  statut        String   @default("PLANIFIEE") // PLANIFIEE, EN_COURS, TERMINEE, ANNULEE
  responsable   String   @default("") // المسؤول عن الحملة
  couleur       String   @default("#10b981") // لون مميز للحملة
  reference     String   @unique // "CAMP-2026-001"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  interventions Intervention[] // التدخلات المرتبطة بالحملة
}

model Quartier {
  id        String @id @default(cuid())
  nom       String // اسم الحي — يمكن تكراره عبر الجماعات
  commune   String @default("") // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر
  latitude  Float
  longitude Float

  @@unique([nom, commune]) // اسم الحي فريد داخل كل جماعة
}

model Product {
  id              String   @id @default(cuid())
  nom             String   // اسم المنتج
  categorie       String   // DERATISATION, DESINSECTISATION, DESINFECTION, GENERAL
  commune         String   @default("") // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر، أو فارغ للمواد المشتركة
  unite           String   @default("لتر") // وحدة القياس: لتر، كيلوغرام، علبة، وحدة
  quantiteStock   Int      @default(0) // الكمية المتوفرة في المخزون
  seuilAlerte     Int      @default(10) // عتبة التنبيه عند انخفاض المخزون
  prixUnitaire    Float    @default(0) // السعر الوحدة
  fournisseur     String   @default("") // المورد
  description     String   @default("") // وصف المنتج
  reference       String   @unique // مرجع المنتج
  imagePath       String?  // مسار صورة المنتج المُخزَّنة (في storage/product-images/)
  dateExpiration  DateTime? // تاريخ انتهاء الصلاحية
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  interventions   InterventionMaterial[]
  movements       StockMovement[]
}

model ProductCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  commune   String   @default("")
  color     String   @default("#6366f1")
  icon      String   @default("📦")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([label, commune])
  @@index([commune])
}

model InterventionMaterial {
  id             String   @id @default(cuid())
  interventionId String
  productId      String
  quantity       Int      @default(0) // الكمية المستعملة في التدخل
  createdAt      DateTime @default(now())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([interventionId, productId])
}

model Agent {
  id        String   @id @default(cuid())
  nom       String   // اسم العون
  prenom    String   @default("") // اللقب
  telephone String   @default("") // رقم الهاتف
  commune   String   @default("") // الجماعة الترابية
  fonction  String   @default("عون صحية") // الوظيفة: عون صحية، مراقب، مسؤول
  actif     Boolean  @default(true) // نشط أو لا
  teamId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workOrders WorkOrder[]
  user       User?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([commune, teamId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  commune     String
  office      String   @default("OFFICE_04")
  mission     String   @default("")
  description String   @default("")
  color       String   @default("#10b981")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agents      Agent[]

  @@index([commune, office])
  @@unique([name, commune])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // اسم المستخدم
  password     String   // كلمة المرور (مشفرة)
  nom          String   // الاسم الكامل
  commune      String   // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر، أو ALL للمسؤول العام
  managedCommunes String @default("[]") // قائمة الجماعات التي يديرها حساب المجموعة
  communeGroupName String? // اسم مجموعة الجماعات عند إدارة أكثر من جماعة
  navVisibilityJson String   @default("{}") // JSON: إظهار/إخفاء الأقسام لهذا الحساب
  role         String   @default("responsable") // الدور: admin، responsable، agent (عون ميداني)
  agentId      String?  @unique
  actif        Boolean  @default(true) // نشط أو لا
  lastLogin    DateTime? // آخر دخول
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  agent        Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // رمز الجلسة
  userId    String   // معرف المستخدم
  expiresAt DateTime // تاريخ الانتهاء
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // "IN" or "OUT"
  quantity    Int
  reason      String?  // "purchase", "usage", "adjustment", "initial"
  note        String?
  commune     String
  createdAt   DateTime @default(now())
}

model CommuneSettings {
  id        String   @id @default(cuid())
  commune   String   @unique // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر
  settings  String   @default("{}") // إعدادات JSON كنص
  updatedAt DateTime @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  titre       String   // عنوان المستند
  description String   @default("") // وصف المستند
  categorie   String   @default("عام") // الفئة: عام، تقارير، محاضر، مراسلات، قرارات، عقود، أخرى
  commune     String   @default("") // الجماعة الترابية
  nomFichier  String   // اسم الملف الأصلي
  cheminFichier String // مسار الملف المخزن
  typeFichier String   @default("") // نوع الملف: pdf, doc, xls, img, etc.
  tailleFichier Int    @default(0) // حجم الملف بالبايت
  reference   String   @default("") // مرجع المستند
  dateDocument DateTime? // تاريخ المستند
  uploadedBy  String   @default("") // اسم المستخدم الذي رفع الملف
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  interventions InterventionDocument[]
  environmentalDossiers EnvironmentalDossierDocument[]
}

model DocumentCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  commune   String   @default("")
  icon      String   @default("📎")
  color     String   @default("#64748b")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([label, commune])
  @@index([commune])
}

// جدول الربط بين التدخلات والمستندات
model InterventionDocument {
  id             String   @id @default(cuid())
  interventionId String   // معرف التدخل
  documentId     String   // معرف المستند
  createdAt      DateTime @default(now())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([interventionId, documentId]) // لا يمكن ربط نفس المستند بنفس التدخل مرتين
}

model InterventionPhoto {
  id             String   @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  url            String   // stored as base64 data URL or file path
  caption        String?  // وصف الصورة
  type           String   @default("AFTER") // "BEFORE" or "AFTER"
  createdAt      DateTime @default(now())
}

model Complaint {
  id             String   @id @default(cuid())
  reference      String   @unique  // "PL-2026-001"
  nomCitoyen     String   // اسم المواطن
  telephone      String?  // رقم الهاتف
  email          String?
  adresse        String   // العنوان
  quartier       String?  // الحي
  commune        String   // الجماعة
  type           String   // "DERATISATION", "DESINSECTISATION", "DESINFECTION", "FOOD", "ANIMAL"
  description    String   // وصف الشكاية
  priorite       String   @default("NORMALE") // "URGENTE", "HAUTE", "NORMALE", "BASSE"
  statut         String   @default("EN_ATTENTE") // "EN_ATTENTE", "EN_COURS", "TRAITEE", "REJETEE"
  source         String   @default("INTERNAL") // "INTERNAL" or "PUBLIC"
  latitude       Float?
  longitude      Float?
  interventionId String?  // linked intervention
  intervention   Intervention? @relation(fields: [interventionId], references: [id])
  environmentalDossierId String?
  environmentalDossier EnvironmentalDossier? @relation(fields: [environmentalDossierId], references: [id], onDelete: SetNull)
  workOrders     WorkOrder[]
  contacts       ComplaintContact[]
  dateReception  DateTime @default(now())
  dateTraitement DateTime?
  observations   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ComplaintContact {
  id            String   @id @default(cuid())
  complaintId   String
  channel       String
  outcome       String
  notes         String   @default("")
  contactedAt   DateTime @default(now())
  contactedBy   String   @default("")
  createdAt     DateTime @default(now())
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, contactedAt])
}

model WorkOrder {
  id              String   @id @default(cuid())
  reference       String   @unique // "OT-2026-AB12CD34"
  commune         String
  title           String
  description     String   @default("")
  priority        String   @default("NORMALE") // "URGENTE", "HAUTE", "NORMALE", "BASSE"
  status          String   @default("NOUVEAU") // "NOUVEAU", "ASSIGNE", "EN_ROUTE", "EN_COURS", "TERMINE", "ANNULE"
  complaintId     String?
  interventionId  String?
  assignedAgentId String?
  scheduledFor    DateTime?
  dueAt           DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  completionNotes String?
  latitude        Float?
  longitude       Float?
  createdBy       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  complaint       Complaint?    @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  intervention    Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  assignedAgent   Agent?        @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  photos          WorkOrderPhoto[]

  @@index([commune, status])
  @@index([assignedAgentId, status])
}

model WorkOrderPhoto {
  id             String   @id @default(cuid())
  workOrderId    String
  storedFileName String   @unique
  originalName   String
  mimeType       String
  size           Int
  type           String   @default("AFTER") // "BEFORE" or "AFTER"
  caption        String?
  uploadedBy     String   @default("")
  createdAt      DateTime @default(now())
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, type])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?  // who performed the action
  userName    String   @default("") // name of user
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT, IMPORT, STATUS_CHANGE
  entityType  String   // INTERVENTION, PRODUCT, AGENT, USER, DOCUMENT, COMPLAINT, SETTINGS
  entityId    String?  // ID of affected entity
  details     String   @default("") // JSON string with change details
  commune     String   @default("") // which commune
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model InterventionComment {
  id             String   @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  authorName     String   // name of commenter
  authorRole     String   @default("") // role
  content        String   // comment text
  type           String   @default("COMMENT") // COMMENT, NOTE, STATUS_CHANGE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== CSVR — Gestion des animaux errants (Capture-Stérilisation-Vaccination-Relâcher) =====

model StrayReport {
  id              String   @id @default(cuid())
  reference       String   @unique // "SIG-CSVR-2026-XXXXXX"
  source          String   @default("INTERNAL") // INTERNAL/PUBLIC/PHONE/AUTHORITY
  declarantName   String   @default("")
  declarantPhone  String   @default("")
  declarantRole   String   @default("") // citoyen/autorité/agent/association
  commune         String   @default("")
  quartier        String   @default("")
  secteur         String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  species         String   @default("DOG") // DOG/CAT/OTHER
  estimatedCount  Int      @default(1)
  hasYoung        Boolean  @default(false)
  isAggressive    Boolean  @default(false)
  isInjured       Boolean  @default(false)
  isSick          Boolean  @default(false)
  rabiesSuspect   Boolean  @default(false)
  biteReported    Boolean  @default(false)
  nearSchool      Boolean  @default(false)
  nearMarket      Boolean  @default(false)
  nearHealth      Boolean  @default(false)
  nearDump        Boolean  @default(false)
  description     String   @default("")
  priority        String   @default("NORMALE") // FAIBLE/NORMALE/HAUTE/URGENTE/SANITAIRE
  statut          String   @default("NOUVEAU") // NOUVEAU/VERIFICATION/VALIDE/MISSION_PLANIFIEE/EN_COURS/TRAITE/PARTIEL/NON_LOCALISE/DOUBLON/CLASSE
  observations    String   @default("")
  missionId       String?
  mission         CaptureMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  photos          StrayReportPhoto[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([commune, statut])
  @@index([commune, priority])
  @@index([species])
}

model StrayReportPhoto {
  id              String   @id @default(cuid())
  reportId        String
  report          StrayReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storedFileName  String   @unique
  originalName    String   @default("")
  mimeType        String   @default("image/jpeg")
  size            Int      @default(0)
  caption         String?
  uploadedBy      String   @default("")
  createdAt       DateTime @default(now())

  @@index([reportId])
}

model CaptureMission {
  id               String   @id @default(cuid())
  reference        String   @unique // "MIS-CSVR-2026-NNN"
  commune          String   @default("")
  quartier         String   @default("")
  latitude         Float?
  longitude        Float?
  zone             String   @default("") // zone d'intervention
  scheduledAt      DateTime?
  priority         String   @default("NORMALE")
  statut           String   @default("PLANIFIEE") // PLANIFIEE/CONFIRME/EN_ROUTE/SUR_PLACE/CAPTURE_EN_COURS/TERMINEE/PARTIEL/REPORTEE/ANNULEE
  teamLead         String   @default("")
  driver           String   @default("")
  agents           String   @default("[]") // JSON array of agent names
  veterinarian     String   @default("")
  vehicle          String   @default("")
  equipment        String   @default("")
  cagesAvailable   Int      @default(0)
  estimatedAnimals Int      @default(0)
  safetyNotes      String   @default("")
  preNotes         String   @default("")
  // Post-mission
  arrivalTime      String?
  endTime          String?
  observedCount    Int?
  capturedCount    Int?
  notCapturedCount Int?
  difficulties     String   @default("")
  incidents        String   @default("")
  agentInjured     Boolean  @default(false)
  biteOccurred     Boolean  @default(false)
  materialDamage   Boolean  @default(false)
  postNotes        String   @default("")
  completedAt      DateTime?
  createdBy        String   @default("")
  reports          StrayReport[]
  animals          StrayAnimal[]
  photos           CaptureMissionPhoto[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([commune, statut])
  @@index([scheduledAt])
}

model CaptureMissionPhoto {
  id              String   @id @default(cuid())
  missionId       String
  mission         CaptureMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  storedFileName  String   @unique
  originalName    String   @default("")
  mimeType        String   @default("image/jpeg")
  size            Int      @default(0)
  type            String   @default("BEFORE") // BEFORE/AFTER
  caption         String?
  uploadedBy      String   @default("")
  createdAt       DateTime @default(now())

  @@index([missionId, type])
}

model StrayAnimal {
  id               String   @id @default(cuid())
  csvrNumber       String   @unique // "BCH-CSVR-2026-000001"
  species          String   @default("DOG") // DOG/CAT/OTHER
  breed            String   @default("")
  sex              String   @default("UNKNOWN") // MALE/FEMALE/UNKNOWN
  estimatedAge     String   @default("")
  weight           Float?
  size             String   @default("") // SMALL/MEDIUM/LARGE
  primaryColor     String   @default("")
  secondaryColors  String   @default("")
  distinctiveMarks String   @default("")
  microchipNumber  String   @default("")
  tagNumber        String   @default("")
  collarNumber     String   @default("")
  qrCode           String   @default("")
  // Origine
  reportId         String?
  missionId        String?
  mission          CaptureMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  captureDate      DateTime?
  captureTime      String?
  captureLocation  String   @default("")
  captureQuartier  String   @default("")
  captureLatitude  Float?
  captureLongitude Float?
  capturedBy       String   @default("")
  // État lors de la capture
  captureState     String   @default("") // CALME/PEUREUX/AGRESSIF/BLESSE/MALADE/AMAIGRI/GESTANTE/ALLAITANTE
  hasParasites     Boolean  @default(false)
  diseaseSuspect   Boolean  @default(false)
  captureNotes     String   @default("")
  // Statut actuel (workflow CSVR)
  statut           String   @default("CAPTURE") // SIGNALISE/LOCALISE/CAPTURE/TRANSPORTE/ADMIT_CENTRE/QUARANTINE/OBSERVATION/SOINS/APTE_STERIL/STERILISE/VACCINE/IDENTIFIE/CONVALESCENCE/PRET_RELACHER/RELACHE/ADOPTABLE/ADOPTE/TRANSFERE/DECEDE/CLOTURE
  commune          String   @default("")
  shelterName      String   @default("")
  boxOrCage        String   @default("")
  // Photos
  mainPhoto        String? // storedFileName
  photos           StrayAnimalPhoto[]
  statusHistory    StrayAnimalStatus[]
  careEvents       StrayAnimalCareEvent[]
  destinations     StrayAnimalDestination[]
  followUps        StrayAnimalFollowUp[]
  biteCases        BiteCase[]
  admissions       StrayAnimalAdmission[]
  transports       StrayAnimalTransport[]
  healthAlerts     StrayAnimalHealthAlert[]
  identifications  StrayAnimalIdentification[]
  createdBy        String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([commune, statut])
  @@index([species])
  @@index([csvrNumber])
}

model StrayAnimalPhoto {
  id              String   @id @default(cuid())
  animalId        String
  animal          StrayAnimal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  storedFileName  String   @unique
  originalName    String   @default("")
  mimeType        String   @default("image/jpeg")
  size            Int      @default(0)
  isMain          Boolean  @default(false)
  caption         String?
  uploadedBy      String   @default("")
  createdAt       DateTime @default(now())

  @@index([animalId])
}

model StrayAnimalStatus {
  id          String   @id @default(cuid())
  animalId    String
  animal      StrayAnimal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  reason      String   @default("")
  changedBy   String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([animalId, createdAt])
}

model CsvrSettings {
  id        String   @id @default(cuid())
  commune   String   @unique
  settings  String   @default("{}") // JSON: speciesTypes, priorityLevels, shelters, centers
  updatedAt DateTime @updatedAt
}

model StrayAnimalCenter {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("REFUGE") // REFUGE/CENTRE_VETERINAIRE/QUARANTINE/OTHER
  commune      String   @default("")
  adresse      String   @default("")
  latitude     Float?
  longitude    Float?
  responsible  String   @default("")
  telephone    String   @default("")
  capacity     Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE/INACTIVE
  notes        String   @default("")
  admissions   StrayAnimalAdmission[]
  createdBy    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([commune, status])
  @@unique([name, commune])
}

model StrayAnimalAdmission {
  id              String            @id @default(cuid())
  animalId        String
  animal          StrayAnimal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  centerId        String
  center          StrayAnimalCenter  @relation(fields: [centerId], references: [id], onDelete: Restrict)
  admittedAt      DateTime          @default(now())
  releasedAt      DateTime?
