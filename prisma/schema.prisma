generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Intervention {
  id                 String   @id @default(cuid())
  type               String   // DERATISATION, DESINSECTISATION, DESINFECTION
  date               DateTime
  quartier           String
  adresse            String
  commune            String   @default("")
  latitude           Float
  longitude          Float
  statut             String   // PLANIFIEE, EN_COURS, TERMINEE, ANNULEE
  description        String   @default("")
  agentNom           String
  produitUtilise     String   @default("")
  quantite           String   @default("")
  superficie         String   @default("")
  nombrePrestations  Int      @default(1)
  observations       String   @default("")
  heureDebut         String?  // "08:00"
  heureFin           String?  // "10:00"
  coutMainOeuvre     Float?   // تكلفة اليد العاملة
  coutMateriaux      Float?   // تكلفة المواد
  coutTotal          Float?   // التكلفة الإجمالية
  reference          String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  materials          InterventionMaterial[]
  documents          InterventionDocument[]
  photos             InterventionPhoto[]
  complaints         Complaint[]
}

model Quartier {
  id        String @id @default(cuid())
  nom       String // اسم الحي — يمكن تكراره عبر الجماعات
  commune   String @default("") // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر
  latitude  Float
  longitude Float

  @@unique([nom, commune]) // اسم الحي فريد داخل كل جماعة
}

model Product {
  id              String   @id @default(cuid())
  nom             String   // اسم المنتج
  categorie       String   // DERATISATION, DESINSECTISATION, DESINFECTION, GENERAL
  commune         String   @default("") // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر، أو فارغ للمواد المشتركة
  unite           String   @default("لتر") // وحدة القياس: لتر، كيلوغرام، علبة، وحدة
  quantiteStock   Int      @default(0) // الكمية المتوفرة في المخزون
  seuilAlerte     Int      @default(10) // عتبة التنبيه عند انخفاض المخزون
  prixUnitaire    Float    @default(0) // السعر الوحدة
  fournisseur     String   @default("") // المورد
  description     String   @default("") // وصف المنتج
  reference       String   @unique // مرجع المنتج
  dateExpiration  DateTime? // تاريخ انتهاء الصلاحية
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  interventions   InterventionMaterial[]
  movements       StockMovement[]
}

model InterventionMaterial {
  id             String   @id @default(cuid())
  interventionId String
  productId      String
  quantity       Int      @default(0) // الكمية المستعملة في التدخل
  createdAt      DateTime @default(now())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([interventionId, productId])
}

model Agent {
  id        String   @id @default(cuid())
  nom       String   // اسم العون
  prenom    String   @default("") // اللقب
  telephone String   @default("") // رقم الهاتف
  commune   String   @default("") // الجماعة الترابية
  fonction  String   @default("عون صحية") // الوظيفة: عون صحية، مراقب، مسؤول
  actif     Boolean  @default(true) // نشط أو لا
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // اسم المستخدم
  password     String   // كلمة المرور (مشفرة)
  nom          String   // الاسم الكامل
  commune      String   // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر، أو ALL للمسؤول العام
  role         String   @default("responsable") // الدور: admin (مسؤول عام)، responsable (مسؤول جماعة)
  actif        Boolean  @default(true) // نشط أو لا
  lastLogin    DateTime? // آخر دخول
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // رمز الجلسة
  userId    String   // معرف المستخدم
  expiresAt DateTime // تاريخ الانتهاء
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // "IN" or "OUT"
  quantity    Int
  reason      String?  // "purchase", "usage", "adjustment", "initial"
  note        String?
  commune     String
  createdAt   DateTime @default(now())
}

model CommuneSettings {
  id        String   @id @default(cuid())
  commune   String   @unique // الجماعة الترابية: سلا، سيدي أبي القنادل، عامر
  settings  String   @default("{}") // إعدادات JSON كنص
  updatedAt DateTime @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  titre       String   // عنوان المستند
  description String   @default("") // وصف المستند
  categorie   String   @default("عام") // الفئة: عام، تقارير، محاضر، مراسلات، قرارات، عقود، أخرى
  commune     String   @default("") // الجماعة الترابية
  nomFichier  String   // اسم الملف الأصلي
  cheminFichier String // مسار الملف المخزن
  typeFichier String   @default("") // نوع الملف: pdf, doc, xls, img, etc.
  tailleFichier Int    @default(0) // حجم الملف بالبايت
  reference   String   @default("") // مرجع المستند
  dateDocument DateTime? // تاريخ المستند
  uploadedBy  String   @default("") // اسم المستخدم الذي رفع الملف
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  interventions InterventionDocument[]
}

// جدول الربط بين التدخلات والمستندات
model InterventionDocument {
  id             String   @id @default(cuid())
  interventionId String   // معرف التدخل
  documentId     String   // معرف المستند
  createdAt      DateTime @default(now())

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([interventionId, documentId]) // لا يمكن ربط نفس المستند بنفس التدخل مرتين
}

model InterventionPhoto {
  id             String   @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  url            String   // stored as base64 data URL or file path
  caption        String?  // وصف الصورة
  type           String   @default("AFTER") // "BEFORE" or "AFTER"
  createdAt      DateTime @default(now())
}

model Complaint {
  id             String   @id @default(cuid())
  reference      String   @unique  // "PL-2026-001"
  nomCitoyen     String   // اسم المواطن
  telephone      String?  // رقم الهاتف
  adresse        String   // العنوان
  quartier       String?  // الحي
  commune        String   // الجماعة
  type           String   // "DERATISATION", "DESINSECTISATION", "DESINFECTION", "AUTRE"
  description    String   // وصف الشكاية
  priorite       String   @default("NORMALE") // "URGENTE", "HAUTE", "NORMALE", "BASSE"
  statut         String   @default("EN_ATTENTE") // "EN_ATTENTE", "EN_COURS", "TRAITEE", "REJETEE"
  interventionId String?  // linked intervention
  intervention   Intervention? @relation(fields: [interventionId], references: [id])
  dateReception  DateTime @default(now())
  dateTraitement DateTime?
  observations   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
