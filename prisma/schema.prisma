// ===== Dossiers unifiés =====
// طبقة توحيد فوق كل الكيانات (Intervention/Complaint/WorkOrder/StrayReport/FoodReport)
// راجع docs/DATA_MODEL.md الفجوة 1 و docs/BACKLOG.md المرحلة 2

model Dossier {
  id              String   @id @default(cuid())
  reference       String   @unique          // DOS-YYYY-NNNNNN
  office          String   @default("")    // OFFICE_01..OFFICE_09 (ثابت في constants)
  type            String   @default("OTHER") // نوع الملف (INSPECTION/COMPLAINT/MISSION/3D_INTERVENTION...)
  title           String   @default("")
  description     String   @default("")
  status          String   @default("NEW") // NEW/ASSIGNED/IN_PROGRESS/INSPECTED/ACTION_REQUIRED/FOLLOW_UP/PENDING_VALIDATION/CLOSED/ARCHIVED
  priority        String   @default("NORMALE") // FAIBLE/NORMALE/HAUTE/URGENTE/SANITAIRE
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  assignedTo      String   @default("")    // userId المكلف (أو فارغ)
  assignedToName  String   @default("")    // اسم المكلف (للعرض السريع)
  dueDate         DateTime?                // مهلة SLA
  closedAt        DateTime?                // متى أُغلق
  // روابط اختيارية للكيانات الموجودة (polymorphic-lite)
  interventionId  String?
  complaintId     String?
  workOrderId     String?
  strayReportId   String?
  foodReportId    String?
  createdBy       String   @default("")    // userId المنشئ
  createdByName   String   @default("")
  notes           String   @default("")
  events          DossierEvent[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([commune, office])
  @@index([commune, type])
  @@index([status])
  @@index([office])
  @@index([assignedTo])
}

model DossierEvent {
  id          String   @id @default(cuid())
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fromStatus  String?                    // الحالة السابقة (null للحدث الأول)
  toStatus    String                      // الحالة الجديدة
  action      String   @default("STATUS_CHANGE") // STATUS_CHANGE/CREATE/ASSIGN/COMMENT/LINK
  reason      String   @default("")
  changedBy   String   @default("")      // userId
  changedByName String @default("")
  metadata    String   @default("{}")    // JSON: تفاصيل إضافية (كيان مربوط، ملاحظة...)
  createdAt   DateTime @default(now())
  @@index([dossierId])
  @@index([dossierId, createdAt])
}

// ===== Bureau 02: Contrôle Sanitaire et Sécurité Alimentaire =====
// راجع docs/BACKLOG.md المرحلة 3

model Establishment {
  id                 String   @id @default(cuid())
  reference          String   @unique          // EST-YYYY-NNNNNN
  name               String   @default("")
  activity           String   @default("")    // النشاط (مطعم/مقهى/بقالة...)
  category           String   @default("")    // الفئة (I/II/III حسب المخاطر)
  ownerName          String   @default("")    // المالك/المستغل
  ownerCin           String   @default("")    // البطاقة الوطنية (عند الاقتضاء)
  telephone          String   @default("")
  commune            String   @default("")
  quartier           String   @default("")
  adresse            String   @default("")
  latitude           Float?
  longitude          Float?
  authorizationNumber String  @default("")    // رقم الرخصة
  authorizationDate  DateTime?                // تاريخ الرخصة
  openingDate        DateTime?                // تاريخ الافتتاح
  status             String   @default("ACTIVE") // ACTIVE/SUSPENDED/CLOSED
  riskCategory       String   @default("UNCLASSIFIED") // LOW/MEDIUM/HIGH/CRITICAL/UNCLASSIFIED
  riskScore          Int      @default(0)     // درجة المخاطر الداخلية 0-100
  description        String   @default("")
  inspections        Inspection[]
  healthCards        HealthCard[]
  samples            Sample[]
  temperatureLogs    TemperatureLog[]
  foodProducts       FoodProduct[]
  labResults         LabResult[]
  nonConformities    FoodNonConformity[]
  fryingOilChecks    FryingOilCheck[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([commune, status])
  @@index([commune, riskCategory])
  @@index([commune, activity])
}

model Inspection {
  id              String   @id @default(cuid())
  reference       String   @unique          // INSP-YYYY-NNNNNN
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  type            String   @default("PERIODIC") // INITIAL/PERIODIC/UNANNOUNCED/COMPLAINT/COUNTER_VISIT/AUTHORIZATION/COMMITTEE
  commune         String   @default("")
  inspectionDate  DateTime @default(now())
  inspectorName   String   @default("")
  inspectorId     String   @default("")     // userId
  overallResult   String   @default("PENDING") // PENDING/CONFORM/NON_CONFORM_MINOR/NON_CONFORM_MAJOR/NON_CONFORM_CRITICAL/CLOSED
  riskScore       Int      @default(0)      // درجة مخاطر هذا التفتيش (0-100)
  checklistJson   String   @default("{}")   // JSON: نتائج قائمة الفحص
  notes           String   @default("")
  status          String   @default("COMPLETED") // PLANNED/COMPLETED/CANCELLED
  foodReportId    String?                   // ربط اختياري ببلاغ غذائي
  foodReport      FoodReport? @relation(fields: [foodReportId], references: [id], onDelete: SetNull)
  findings        Finding[]
  correctiveActions CorrectiveAction[]
  counterVisits   CounterVisit[]
  temperatureLogs TemperatureLog[]
  foodProducts    FoodProduct[]
  nonConformities FoodNonConformity[]
  fryingOilChecks FryingOilCheck[]
  samples         Sample[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([establishmentId])
  @@index([commune, inspectionDate])
  @@index([commune, overallResult])
}

model Finding {
  id              String   @id @default(cuid())
  inspectionId    String
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category        String   @default("")    // فئة النقص (نظافة/طاقم/أسطح/تخزين...)
  description     String   @default("")
  severity        String   @default("MINOR") // MINOR/MAJOR/CRITICAL
  weight          Int      @default(1)      // وزن النقص في درجة المخاطر
  status          String   @default("OPEN") // OPEN/CORRECTED
  createdAt       DateTime @default(now())
  @@index([inspectionId])
  @@index([severity])
}

model CorrectiveAction {
  id              String   @id @default(cuid())
  inspectionId    String
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  description     String   @default("")
  responsible     String   @default("")
  deadline        DateTime?
  status          String   @default("PENDING") // PENDING/IN_PROGRESS/DONE/VERIFIED
  verifiedAt      DateTime?
  verifiedBy      String   @default("")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([inspectionId])
  @@index([status])
}

model CounterVisit {
  id              String   @id @default(cuid())
  inspectionId    String
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  visitDate       DateTime @default(now())
  visitorName     String   @default("")
  result          String   @default("PENDING") // PENDING/CONFORM/NON_CONFORM/CLOSED
  findingsResolved String  @default("0")        // عدد النقائص المحلولة
  notes           String   @default("")
  createdAt       DateTime @default(now())
  @@index([inspectionId])
}

model HealthCard {
  id              String   @id @default(cuid())
  reference       String   @unique          // CS-YYYY-NNNNNN (Carte Sanitaire)
  workerName      String   @default("")
  workerCin       String   @default("")
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  occupation      String   @default("")    // المهنة
  commune         String   @default("")
  cardNumber      String   @default("")
  issueDate       DateTime?
  expiryDate      DateTime?                 // تنبيهات الانتهاء
  examinationDate DateTime?
  status          String   @default("VALID") // VALID/EXPIRED/PENDING/RENEWING
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([establishmentId])
  @@index([commune, status])
  @@index([expiryDate])
}

model Sample {
  id              String   @id @default(cuid())
  reference       String   @unique          // ECH-YYYY-NNNNNN
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
