// ===== Bureau 06: Protection de l'Environnement =====
// راجع docs/BACKLOG.md المرحلة 7

model EnvironmentalDossier {
  id              String   @id @default(cuid())
  reference       String   @unique          // ENV-YYYY-NNNNNN
  title           String   @default("")
  category        String   @default("OTHER") // POLLUTION/WASTE/PROJECT/IMPACT_REVIEW/SITE/NATURAL_HERITAGE/OTHER
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  description     String   @default("")
  riskScore       Int      @default(0)      // درجة المخاطر البيئية الداخلية (0-100)
  probability     Int      @default(1)      // احتمال الحدوث 1..5
  severity        Int      @default(1)      // شدة الأثر 1..5
  riskLevel       String   @default("LOW")  // LOW/MEDIUM/HIGH/CRITICAL
  priority        String   @default("NORMALE")
  status          String   @default("NEW")  // NEW/IN_PROGRESS/INSPECTED/ACTION_REQUIRED/CLOSED
  assignedTo      String   @default("")
  company         String   @default("")     // الشركة المعنية
  progress        Int      @default(0)      // نسبة التقدم %
  notes           String   @default("")
  source          String   @default("INTERNAL") // INTERNAL/PUBLIC/PHONE/AUTHORITY
  probableSource  String   @default("")
  extent          String   @default("") // LOCAL/QUARTER/COMMUNAL/INTERCOMMUNAL
  exposedPopulation Int    @default(0)
  milieu          String   @default("") // AIR/WATER/SOIL/URBAN/NATURAL/OTHER
  servicesConcerned String @default("[]") // الخدمات والشركاء المعنيون
  legalReference  String   @default("") // أساس قانوني قابل للتحقق
  measuresTaken   String   @default("") // الإجراءات المتخذة
  dueDate         DateTime?
  inspectionDate  DateTime?
  nextFollowUpDate DateTime?
  closedAt        DateTime?
  unifiedDossierId String? @unique
  documents       EnvironmentalDossierDocument[]
  evidence        EnvironmentalEvidence[]
  inspections     EnvironmentalInspection[]
  followUps       EnvironmentalFollowUp[]
  programs        EnvironmentalProgram[]
  pollutionIncidents PollutionIncident[]
  wasteSpots      WasteBlackSpot[]
  naturalSites    NaturalSite[]
  campaigns       AwarenessCampaign[]
  complaints      Complaint[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([commune, category])
  @@index([riskLevel])
}

model EnvironmentalInspection {
  id                     String   @id @default(cuid())
  reference              String   @unique // EINS-YYYY-XXXXXX
  environmentalDossierId String
  commune                String   @default("")
  inspectionDate         DateTime @default(now())
  inspectorName          String   @default("")
  observation            String   @default("")
  probableSource         String   @default("")
  extent                 String   @default("")
  exposedPopulation      Int      @default(0)
  milieu                 String   @default("")
  probability            Int      @default(1)
  severity               Int      @default(1)
  riskScore              Int      @default(1)
  riskLevel              String   @default("LOW")
  resolution             String   @default("PENDING") // YES/NO/PARTIAL/PENDING
  nextAction             String   @default("")
  nextFollowUpDate       DateTime?
  notes                  String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  environmentalDossier EnvironmentalDossier @relation(fields: [environmentalDossierId], references: [id], onDelete: Cascade)

  @@index([commune, inspectionDate])
  @@index([environmentalDossierId, inspectionDate])
}

model EnvironmentalFollowUp {
  id                     String   @id @default(cuid())
  reference              String   @unique // EFOL-YYYY-XXXXXX
  environmentalDossierId String
  commune                String   @default("")
  followUpDate           DateTime @default(now())
  employeeName           String   @default("")
  currentStatus          String   @default("")
  damageRemoved          String   @default("PENDING") // YES/NO/PARTIAL/PENDING
  notes                  String   @default("")
  nextAction             String   @default("")
  nextFollowUpDate       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  environmentalDossier EnvironmentalDossier @relation(fields: [environmentalDossierId], references: [id], onDelete: Cascade)

  @@index([commune, followUpDate])
  @@index([environmentalDossierId, followUpDate])
}

model EnvironmentalProgram {
  id              String   @id @default(cuid())
  reference       String   @unique // EPRG-YYYY-XXXXXX
  year            Int
  operation       String
  axis            String   @default("")
  commune         String   @default("")
  environmentalDossierId String?
  quartier        String   @default("")
  objective       String   @default("")
  responsible     String   @default("")
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  indicator       String   @default("")
  quantitativeTarget Int   @default(0)
  achieved        Int      @default(0)
  progress        Int      @default(0)
  status          String   @default("PLANNED") // PLANNED/IN_PROGRESS/COMPLETED/DELAYED/CANCELLED
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  environmentalDossier EnvironmentalDossier? @relation(fields: [environmentalDossierId], references: [id], onDelete: SetNull)
  campaigns       AwarenessCampaign[]

  @@index([commune, year])
  @@index([commune, status])
  @@index([environmentalDossierId])
}

model EnvironmentalDossierDocument {
  id                     String   @id @default(cuid())
  environmentalDossierId String
  documentId             String
  createdAt              DateTime @default(now())

  environmentalDossier EnvironmentalDossier @relation(fields: [environmentalDossierId], references: [id], onDelete: Cascade)
  document             Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([environmentalDossierId, documentId])
  @@index([documentId])
}

model EnvironmentalEvidence {
  id                     String   @id @default(cuid())
  environmentalDossierId String
  url                    String   // صورة أو فيديو محفوظ كبيانات آمنة
  caption                String   @default("")
  type                   String   @default("INSPECTION") // BEFORE/AFTER/INSPECTION/ANALYSIS/CORRESPONDENCE
  mimeType               String   @default("")
  originalName           String   @default("")
  uploadedBy             String   @default("")
  createdAt              DateTime @default(now())

  environmentalDossier EnvironmentalDossier @relation(fields: [environmentalDossierId], references: [id], onDelete: Cascade)

  @@index([environmentalDossierId, type])
}

model PollutionIncident {
  id              String   @id @default(cuid())
  reference       String   @unique          // POL-YYYY-NNNNNN
  type            String   @default("AIR")  // AIR/WATER/SOIL/NOISE/OdOUR/SMOKE/DUST/WASTEWATER/INDUSTRIAL
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  description     String   @default("")
  source          String   @default("INTERNAL") // INTERNAL/PUBLIC/PHONE
  declarantName   String   @default("")
  declarantPhone  String   @default("")
  pollutantName   String   @default("")     // اسم الملوّث
  severity        String   @default("LOW")  // LOW/MEDIUM/HIGH/CRITICAL
  company         String   @default("")     // المصدر المتسبب
  environmentalDossierId String?
  status          String   @default("NEW")  // NEW/INVESTIGATING/MITIGATING/CLOSED
  mitigation      String   @default("")     // إجراءات التخفيف
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environmentalDossier EnvironmentalDossier? @relation(fields: [environmentalDossierId], references: [id], onDelete: SetNull)
  @@index([commune, status])
  @@index([commune, type])
  @@index([severity])
  @@index([environmentalDossierId])
}

model WasteBlackSpot {
  id              String   @id @default(cuid())
  reference       String   @unique          // DEP-YYYY-NNNNNN
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  description     String   @default("")
  wasteType       String   @default("MIXED") // HOUSEHOLD/CONSTRUCTION/INDUSTRIAL/GREEN/MIXED
  recurring       Boolean  @default(false)   // نقطة رمي متكررة
  recurrenceCount Int      @default(0)       // عدد مرات الرصد
  source          String   @default("INTERNAL")
  status          String   @default("ACTIVE") // ACTIVE/CLEANED/MONITORING/CLOSED
  lastCleanedAt   DateTime?
  notes           String   @default("")
  environmentalDossierId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environmentalDossier EnvironmentalDossier? @relation(fields: [environmentalDossierId], references: [id], onDelete: SetNull)
  @@index([commune, status])
  @@index([commune, recurring])
  @@index([environmentalDossierId])
}

model NaturalSite {
  id              String   @id @default(cuid())
  reference       String   @unique          // SITE-YYYY-NNNNNN
  name            String   @default("")
  type            String   @default("FOREST") // FOREST/WETLAND/COASTAL/PARK/RESERVE/HISTORICAL/OTHER
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  area            Float?                    // المساحة (هكتار)
  description     String   @default("")
  protectionLevel String   @default("NONE") // NONE/LOCAL/REGIONAL/NATIONAL/INTERNATIONAL
  status          String   @default("INTACT") // INTACT/THREATENED/DEGRADED/PROTECTED
  threats         String   @default("")     // التهديدات
  notes           String   @default("")
  environmentalDossierId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environmentalDossier EnvironmentalDossier? @relation(fields: [environmentalDossierId], references: [id], onDelete: SetNull)
  @@index([commune, status])
  @@index([commune, type])
  @@index([environmentalDossierId])
}

model AwarenessCampaign {
  id              String   @id @default(cuid())
  reference       String   @unique          // CAMP-ENV-YYYY-NNNNNN
  title           String   @default("")
  theme           String   @default("GENERAL") // WASTE_REDUCTION/RECYCLING/WATER/AIR/BIODIVERSITY/TREE_PLANTING/GENERAL
  commune         String   @default("")
  environmentalDossierId String?
  environmentalProgramId String?
  description     String   @default("")
  targetAudience  String   @default("")     // الجمهور المستهدف
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  participantsCount Int    @default(0)
  organizerName   String   @default("")
  status          String   @default("PLANNED") // PLANNED/ACTIVE/COMPLETED/CANCELLED
  outcomes        String   @default("")     // النتائج
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environmentalDossier EnvironmentalDossier? @relation(fields: [environmentalDossierId], references: [id], onDelete: SetNull)
  environmentalProgram EnvironmentalProgram? @relation(fields: [environmentalProgramId], references: [id], onDelete: SetNull)
  @@index([commune, status])
  @@index([commune, theme])
  @@index([environmentalDossierId])
  @@index([environmentalProgramId])
}

// ===== Bureau 08: Avis Sanitaire, Autorisations et Commissions =====
// راجع docs/BACKLOG.md المرحلة 9
// ⚠️ كل رأي/ترخيص يتطلب مصادقة يدوية. راجع docs/LEGAL_SAFETY.md.
// ملاحظة: لا ادّعاء تكامل Rokhas — rokhasReference حقل نصي اختياري فقط.

model AuthorizationDossier {
  id              String   @id @default(cuid())
  reference       String   @unique          // AUT-YYYY-NNNNNN
  applicantName   String   @default("")     // مقدم الطلب
  applicantCin    String   @default("")     // البطاقة الوطنية
  applicantPhone  String   @default("")
  establishmentName String @default("")     // اسم المنشأة المراد ترخيصها
  activity        String   @default("")     // النشاط
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  // نوع الرأي المطلوب
  requestType     String   @default("COMMERCIAL") // COMMERCIAL/BUILDING/OCCUPANCY/CONFORMITY/CLASSIFIED
  // المرجع الخارجي (Rokhas) — اختياري، نص فقط، لا تكامل API
  rokhasReference String   @default("")
  // الرأي الصحي
  opinionStatus   String   @default("PENDING") // PENDING/FAVORABLE/FAVORABLE_RESERVATIONS/UNFAVORABLE/ADDITIONAL_INFO
  opinionDate     DateTime?
  opinionNotes    String   @default("")     // ملاحظات الرأي
  reservations    String   @default("")     // التحفّظات
  competentAuthority String @default("")    // الجهة المختصة
  legalReference  String   @default("")     // المرجع القانوني
  authorizedBy    String   @default("")     // من أصدر الرأي
  status          String   @default("NEW")  // NEW/UNDER_REVIEW/OPINION_ISSUED/CLOSED/REJECTED
  checklistJson   String   @default("[]")   // JSON: قائمة الوثائق المطلوبة
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([commune, requestType])
  @@index([opinionStatus])
}

model SanitaryOpinion {
  id              String   @id @default(cuid())
  reference       String   @unique          // AVIS-YYYY-NNNNNN
  dossierId       String?                   // ربط بملف ترخيص
  establishmentName String @default("")
  commune         String   @default("")
  opinionType     String   @default("COMMERCIAL") // COMMERCIAL/BUILDING/OCCUPANCY/CONFORMITY
  // الرأي
  result          String   @default("PENDING") // PENDING/FAVORABLE/FAVORABLE_RESERVATIONS/UNFAVORABLE
  date            DateTime @default(now())
  inspectorName   String   @default("")
  observations    String   @default("")
  reservations    String   @default("")     // التحفّظات
  correctiveActions String @default("")     // الإجراءات التصحيحية المطلوبة
  recommendation  String   @default("")     // التوصية النهائية
  // المصادقة
  validationStatus String  @default("PENDING") // PENDING/APPROVED/REJECTED
  validatedBy     String   @default("")
  validatedAt     DateTime?
  legalReference  String   @default("")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, result])
  @@index([validationStatus])
  @@index([dossierId])
}

model CommitteeVisit {
  id              String   @id @default(cuid())
  reference       String   @unique          // VIS-YYYY-NNNNNN
  dossierId       String?                   // ربط بملف ترخيص
  establishmentName String @default("")
  commune         String   @default("")
  visitDate       DateTime @default(now())
  // المشاركون
  participantsJson String  @default("[]")   // JSON: قائمة المشاركين
  // المعاينة
  inspectionNotes String   @default("")
  findingsJson    String   @default("[]")   // JSON: الملاحظات/النقائص
  // النتيجة
  recommendation  String   @default("PENDING") // PENDING/FAVORABLE/FAVORABLE_RESERVATIONS/UNFAVORABLE
  reservations    String   @default("")
  correctiveActions String @default("")
  // المصادقة
  validationStatus String  @default("PENDING")
  validatedBy     String   @default("")
  validatedAt     DateTime?
  notes           String   @default("")
  status          String   @default("PLANNED") // PLANNED/COMPLETED/CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([dossierId])
  @@index([visitDate])
}
