  inspection      Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  commune         String   @default("")
  product         String   @default("")    // المنتج المفحوص
  sampleDate      DateTime @default(now())
  reason          String   @default("")    // سبب الأخذ
  temperature     Float?                   // حرارة العينة
  collectorName   String   @default("")    // جامع العينة
  laboratory      String   @default("")    // المخبر
  requestedTests  String   @default("")    // الاختبارات المطلوبة
  resultsJson     String   @default("{}")  // JSON: النتائج (معامل/قيمة/مطابقة)
  conformity      String   @default("PENDING") // PENDING/CONFORM/NON_CONFORM
  labResults      LabResult[]
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([establishmentId])
  @@index([inspectionId])
  @@index([commune, conformity])
  @@index([sampleDate])
}

model TemperatureLog {
  id                String   @id @default(cuid())
  reference         String   @unique          // TEMP-YYYY-NNNNNN
  establishmentId   String
  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inspectionId      String?
  inspection        Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  commune           String   @default("")
  equipmentType     String   @default("REFRIGERATOR") // REFRIGERATOR/COLD_ROOM/FREEZER/DISPLAY/PRODUCT/RECEPTION
  equipmentName     String   @default("")
  product           String   @default("")
  measuredAt        DateTime @default(now())
  temperature      Float
  unit              String   @default("°C")
  referenceMin      Float?
  referenceMax      Float?
  conformity        String   @default("PENDING") // PENDING/CONFORM/NON_CONFORM
  deviceCode        String   @default("")
  agentName         String   @default("")
  correctiveAction  String   @default("")
  notes             String   @default("")
  createdBy         String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([establishmentId, measuredAt])
  @@index([inspectionId])
  @@index([commune, conformity])
}

model FoodProduct {
  id                  String   @id @default(cuid())
  reference           String   @unique          // PROD-YYYY-NNNNNN
  establishmentId     String
  establishment       Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inspectionId        String?
  inspection          Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  commune             String   @default("")
  product             String   @default("")
  category            String   @default("")
  brand               String   @default("")
  lot                 String   @default("")
  supplier            String   @default("")
  receivedAt          DateTime?
  expiryDate          DateTime?
  openingDate         DateTime?
  preparationDate     DateTime?
  quantity            Float?
  unit                String   @default("")
  storage             String   @default("")
  packagingCondition  String   @default("")
  labelingStatus      String   @default("PENDING")
  traceabilityStatus  String   @default("PENDING")
  conformity          String   @default("PENDING")
  observedTemperature Float?
  notes               String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([establishmentId, expiryDate])
  @@index([inspectionId])
  @@index([commune, conformity])
}

model LabResult {
  id              String   @id @default(cuid())
  reference       String   @unique          // LAB-YYYY-NNNNNN
  sampleId        String
  sample          Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  commune         String   @default("")
  laboratory      String   @default("")
  receivedAt      DateTime?
  analyzedAt      DateTime?
  parameter       String   @default("")
  resultValue     String   @default("")
  unit            String   @default("")
  method          String   @default("")
  referenceValue  String   @default("")
  conformity      String   @default("PENDING")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([sampleId])
  @@index([establishmentId, conformity])
}

model FoodNonConformity {
  id              String   @id @default(cuid())
  reference       String   @unique          // NC-YYYY-NNNNNN
  establishmentId String
