  // المتابعة الإدارية (لا تشخيص طبي آلي)
  source          String   @default("INTERNAL") // INTERNAL/PUBLIC/HOSPITAL/AUTHORITY
  status          String   @default("NEW") // NEW/REPORTED/FOLLOWING/VACCINATION_STARTED/VACCINATION_COMPLETE/CLOSED/LOST_CONTACT
  reportingDate   DateTime @default(now())
  followUpNotes   String   @default("")
  assignedTo      String   @default("")
  strayReportId   String?                  // ربط اختياري ببلاغ CSVR
  animalId        String?
  animal          StrayAnimal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  vaccinationSteps BiteVaccinationStep[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([commune, animalType])
  @@index([biteDate])
  @@index([animalId])
}

model BiteVaccinationStep {
  id              String   @id @default(cuid())
  biteCaseId      String
  stepKey         String   // WOUND_CARE/RIG/DAY_0/DAY_3/DAY_7/DAY_14...
  label           String   @default("")
  status          String   @default("PLANNED") // PLANNED/DONE/MISSED/CANCELLED
  scheduledDate   DateTime?
  administeredDate DateTime?
  vaccineType    String   @default("")
  route          String   @default("")
  lotNumber      String   @default("")
  facility       String   @default("")
  administeredBy String   @default("")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  biteCase       BiteCase @relation(fields: [biteCaseId], references: [id], onDelete: Cascade)
  @@unique([biteCaseId, stepKey])
  @@index([biteCaseId, scheduledDate])
  @@index([status])
}

// ===== Bureau 05: Funérailles, Cimetières et Morgue =====
// راجع docs/BACKLOG.md المرحلة 6
// ⚠️ كل إذن يتطلب مصادقة يدوية + حقول قانونية قابلة للتهيئة. راجع docs/LEGAL_SAFETY.md.

model DeathCase {
  id              String   @id @default(cuid())
  reference       String   @unique          // DEC-YYYY-NNNNNN
  deceasedName    String   @default("")     // اسم المتوفى
  deceasedCin     String   @default("")     // البطاقة الوطنية
  deceasedAge     Int?
  deceasedGender  String   @default("")    // M/F
  deathDate       DateTime?
  deathCause      String   @default("")    // سبب الوفاة (عام)
  deathPlace      String   @default("")    // مكان الوفاة
  commune         String   @default("")
  // حالة المستودع (morgue)
  morgueStatus    String   @default("NONE") // NONE/ADMITTED/RELEASED
  morgueAdmissionDate DateTime?
  morgueReleaseDate   DateTime?
  // مصدر البلاغ
  source          String   @default("INTERNAL") // INTERNAL/HOSPITAL/AUTHORITY/PUBLIC
  declarantName   String   @default("")
  declarantPhone  String   @default("")
  status          String   @default("NEW") // NEW/MORGUE/BURIED/TRANSPORTED/EXHUMED/CLOSED
  notes           String   @default("")
  burialId        String?                   // ربط بملف الدفن
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([deathDate])
}

model BurialDossier {
  id              String   @id @default(cuid())
  reference       String   @unique          // DEF-YYYY-NNNNNN
  deceasedName    String   @default("")
  deceasedCin     String   @default("")
  commune         String   @default("")
  cemeteryId      String?                   // المقبرة
  cemetery        Cemetery? @relation("BurialCemetery", fields: [cemeteryId], references: [id], onDelete: SetNull)
  plotSection     String   @default("")    // القسم/القبر
  burialDate      DateTime?
  // ⚠️ إذن الدفن — يتطلب مصادقة يدوية + مرجع قانوني
  authorizationStatus String @default("PENDING") // PENDING/APPROVED/REJECTED
  authorizedBy    String   @default("")    // الموظف المختص
  authorizedAt    DateTime?
  legalReference  String   @default("")    // المرجع القانوني (قابل للتهيئة)
  competentAuthority String @default("")   // الجهة المختصة
  deathCaseId     String?                   // ربط بحالة الوفاة
  officiantName   String   @default("")    // إمام/موظف الجنائز
  notes           String   @default("")
  status          String   @default("NEW") // NEW/AUTHORIZED/BURIED/CLOSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
  @@index([cemeteryId])
}

model Cemetery {
  id              String   @id @default(cuid())
  reference       String   @unique          // CIM-YYYY-NNNNNN
  name            String   @default("")
  type            String   @default("MUSLIM") // MUSLIM/JEWISH/CHRISTIAN/COMMUNAL
  commune         String   @default("")
  quartier        String   @default("")
  adresse         String   @default("")
  latitude        Float?
  longitude       Float?
  capacity        Int      @default(0)      // الطاقة الاستيعابية التقديرية
  occupied        Int      @default(0)      // القبور المشغولة
  sectionsJson    String   @default("[]")   // JSON: الأقسام والقيعان
  status          String   @default("ACTIVE") // ACTIVE/FULL/CLOSED/MAINTENANCE
  notes           String   @default("")
  burials         BurialDossier[] @relation("BurialCemetery")
  exhumations     ExhumationDossier[] @relation("ExhumationCemetery")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
}

model CorpseTransport {
  id              String   @id @default(cuid())
  reference       String   @unique          // TRANS-YYYY-NNNNNN
  deceasedName    String   @default("")
  commune         String   @default("")
  // الرحلة
  originPlace     String   @default("")    // مكان الانطلاق
  destinationPlace String  @default("")    // الوجهة
  transportDate   DateTime?
  vehiclePlate    String   @default("")    // لوحة المركبة
  driverName      String   @default("")    // السائق
  driverPhone     String   @default("")
  // ⚠️ إذن النقل
  authorizationStatus String @default("PENDING")
  authorizedBy    String   @default("")
  authorizedAt    DateTime?
  legalReference  String   @default("")
  deathCaseId     String?
  status          String   @default("NEW") // NEW/AUTHORIZED/IN_TRANSIT/COMPLETED/CANCELLED
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([commune, status])
}

model ExhumationDossier {
  id              String   @id @default(cuid())
  reference       String   @unique          // EXH-YYYY-NNNNNN
  deceasedName    String   @default("")
  deceasedCin     String   @default("")
  commune         String   @default("")
  cemeteryId      String?
  cemetery        Cemetery? @relation("ExhumationCemetery", fields: [cemeteryId], references: [id], onDelete: SetNull)
  plotSection     String   @default("")
  originalBurialDate DateTime?
  exhumationDate  DateTime?
  reason          String   @default("")    // سبب النبش
  newDestination  String   @default("")    // الوجهة الجديدة
  // ⚠️ إذن النبش — حساس جداً
  authorizationStatus String @default("PENDING")
  authorizedBy    String   @default("")
  authorizedAt    DateTime?
  legalReference  String   @default("")
  competentAuthority String @default("")
  requesterName   String   @default("")    // مقدم الطلب
  requesterCin    String   @default("")
  status          String   @default("NEW") // NEW/AUTHORIZED/COMPLETED/REJECTED
  notes           String   @default("")
